<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <ContainerRepository>mpelabs.dnslookup</ContainerRepository>
        <AssemblyVersion>0.0.0</AssemblyVersion>
    </PropertyGroup>

    <!-- Docker HEALTHCHECK instruction embedded in the container image built by dotnet publish /t:PublishContainer.
         /alive is used (liveness only) so the check is fast and has no external dependencies.
         Port 8080 is the default HTTP port for .NET 8+ SDK-published container images.
         Azure Web App for Containers uses WEBSITE_WARMUP_PATH=/alive separately (App Service setting). -->
    <PropertyGroup>
        <ContainerHealthCheckCommand>wget -qO- http://localhost:8080/alive || exit 1</ContainerHealthCheckCommand>
        <ContainerHealthCheckInterval>PT30S</ContainerHealthCheckInterval>
        <ContainerHealthCheckTimeout>PT5S</ContainerHealthCheckTimeout>
        <ContainerHealthCheckRetries>3</ContainerHealthCheckRetries>
        <ContainerHealthCheckStartPeriod>PT15S</ContainerHealthCheckStartPeriod>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="DnsClient" Version="1.8.0" />
        <PackageReference Include="ErrorOr" Version="2.1.1" />
        <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" Version="4.14.2" />
        <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components.Icons" Version="4.14.2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\mpelabs.dnslookup.ServiceDefaults\mpelabs.dnslookup.ServiceDefaults.csproj" />
    </ItemGroup>
</Project>
